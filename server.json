{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.finimpulse/mcp-server",
  "title": "FinImpulse",
  "description": "Global prices, fundamentals and holdings data for stocks, ETFs and funds, built for AI agents.",
  "websiteUrl": "https://finimpulse.com/mcp-server/",
  "repository": {
    "url": "https://github.com/finimpulse/mcp-server-typescript",
    "source": "github"
  },
  "version": "1.3.3",
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.finimpulse.com/mcp"
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "identifier": "finimpulse-mcp-server",
      "version": "1.3.3",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "API_TOKEN",
          "description": "FinImpulse API token from https://app.finimpulse.com/developer/settings",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ]
}
