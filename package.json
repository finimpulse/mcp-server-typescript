{
  "name": "finimpulse-mcp-server",
  "version": "1.2.1",
  "description": "MCP server for FinImpulse financial market data API",
  "main": "build/index.js",
  "type": "module",
  "bin": {
    "finimpulse-mcp-server": "./build/index.js"
  },
  "scripts": {
    "build": "tsc && chmod 755 build/index.js",
    "cli": "node build/index.js",
    "http": "MCP_TRANSPORT=http node build/index.js",
    "inspect": "npx @modelcontextprotocol/inspector node build/index.js",
    "inspect:cli": "npx @modelcontextprotocol/inspector --cli node build/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "files": [
    "build"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/finimpulse/mcp-server-typescript.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "finimpulse",
    "finance",
    "financial-data",
    "stocks",
    "etf",
    "mutual-funds",
    "market-data",
    "ai",
    "llm"
  ],
  "author": "FinImpulse",
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.2.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  }
}
